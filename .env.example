# Portfolio Frontend Environment Variables

# URL of your Go RAG backend on Render (or local dev)
# Leave blank to use Vite dev proxy (http://127.0.0.1:8080) or local KB fallback
# Example for Render: https://your-service-name.onrender.com
VITE_API_URL=

# Optional: Custom contact form submission endpoint (e.g., Formspree, Web3Forms, or custom backend)
# Defaults to https://formsubmit.co/ajax/aswinsreeraj96@gmail.com if left blank
VITE_CONTACT_ENDPOINT=
